# rn1 Counter-Strike follower (PAPER by default)
ENABLE_TRADING=true

# Market filter disabled (follow all markets for rn1). Leave empty to disable.
TRADE_FILTER_REGEX=

# Sizing / limits
COPY_RATIO=0.001
MIN_MY_USDC_PER_SIGNAL=1
MAX_MY_USDC_PER_SIGNAL=5
MIN_SHARES_PER_ORDER=5

# Hard guards for bankroll (~91 USDC)
MAX_SPREAD_ABS=0.011
MAX_CONSECUTIVE_ORDER_FAILURES=10

# RN1 is very high-frequency: cap scale-ins per market.
# Backward compatible: this env can be true/false OR a number (e.g. 2).
ONE_POSITION_PER_MARKET=false

# Extra guard to avoid two BUYs near-identical back-to-back.
BUY_COOLDOWN_MS=60000
BUY_MIN_PRICE_DELTA_ABS=0.003

# Hybrid execution style
COPY_EXEC_STYLE=hybrid
COPY_MOMENTUM_TRIGGER_ABS=0.02

# Risk exits
COPY_STOP_LOSS_ABS=0.03
COPY_TRAIL_ABS=0
COPY_MAX_HOLD_MS=21600000

# Reconcile with trader exits
COPY_EXIT_RECONCILE_POLL_MS=60000

# Data API
DATA_API_BASE=https://data-api.polymarket.com
ACTIVITY_LIMIT=50

# Logging
LOG_LEVEL=info
