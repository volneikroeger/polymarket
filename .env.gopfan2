# Arquivo .env para o serviço gopfan2
# Requer chave privada e pode usar configuração de rede específica se necessário.

ENABLE_TRADING=true
CONFIG_PATH=/root/.openclaw/workspace/polymarket-copytrader/config-gopfan2.yml

# RN1 é muito de alta frequência: limite as scale-ins por mercado.
# Compatível com versões anteriores: este ambiente pode ser true/false OR um número (ex. 2).
# Usando 'true' para gopfan2, para garantir uma posição por mercado.
ONE_POSITION_PER_MARKET=true

# Guardas adicionais para evitar dois BUYs quase idênticos consecutivamente.
BUY_COOLDOWN_MS=60000
BUY_MIN_PRICE_DELTA_ABS=0.005 # Spread um pouco maior para gopfan2

# Estilo de execução híbrido
COPY_EXEC_STYLE=hybrid
COPY_MOMENTUM_TRIGGER_ABS=0.02

# Saídas de risco
COPY_STOP_LOSS_ABS=0.03
COPY_TRAIL_ABS=0
COPY_MAX_HOLD_MS=3600000 # 1h de hold máximo

# Reconciliação com saídas do trader
COPY_EXIT_RECONCILE_POLL_MS=60000

# Chave privada para assinar transações.
# Certifique-se de que esta chave é segura e tem a permissão correta.
PRIVATE_KEY=0xaa634cbad295156885c807fd6ead8f71fc7c39b4afcb1c7a0606bafe9dd52bb9
