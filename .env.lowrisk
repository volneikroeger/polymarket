# Low-risk strategy process (separate from main copytrader)
# Default: paper + trading disabled.

# Kill switch
ENABLE_TRADING=false

# Execution quality (spread guard)
# Skip if (bestAsk-bestBid) is wider than this absolute amount.
MAX_SPREAD_ABS=0.01
# Optionally, also cap spread in bps of mid. 0 disables.
MAX_SPREAD_BPS=0

# Circuit breaker
MAX_CONSECUTIVE_ORDER_FAILURES=2

# Polymarket auth (reuse same signer config approach)
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137
SIGNATURE_TYPE=1
FUNDER=0xd9d712fd23e174ec269f4a9527493e89af8e4fba
USE_SERVER_TIME=true
VERIFY_L2=true

# Mirror / Data API
DATA_API_BASE=https://data-api.polymarket.com
ACTIVITY_LIMIT=50

# Sizing: conservative
COPY_RATIO=0.0005
MAX_MY_USDC_PER_SIGNAL=1
MIN_MY_USDC_PER_SIGNAL=1
MIN_SHARES_PER_ORDER=5
ACCUM_TTL_MS=86400000

# Networking robustness
FETCH_RETRIES=6
FETCH_TIMEOUT_MS=20000

# Logging
LOG_LEVEL=info
MIRROR_STATS_INTERVAL_MS=300000
