# DO NOT COMMIT REAL SECRETS.

# --- Your trading wallet ---
# Private key used to sign requests / order payloads.
# WARNING: Treat this as compromised if it was ever pasted into chat logs.
PRIVATE_KEY=0xaa634cbad295156885c807fd6ead8f71fc7c39b4afcb1c7a0606bafe9dd52bb9

# Polymarket CLOB host + chain
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137

# Signature type (0=EOA, 1=POLY_PROXY, 2=GNOSIS_SAFE)
SIGNATURE_TYPE=1

# Funder address (only needed for POLY_PROXY / GNOSIS_SAFE)
FUNDER=0xd9d712fd23e174ec269f4a9527493e89af8e4fba

# --- Optional: Use existing API creds instead of deriving ---
#POLY_API_KEY=019c3d53-7908-76a9-aaee-eb8f756f0841
#POLY_API_SECRET=HCvCdaWvnxywBbykIqkXhbTcOMJ6Di5O79QsD7QFf8A=
#POLY_API_PASSPHRASE=c21b4ccf1075e6145a3384e6624b41bb2377b00c79bda225a44bf2736e7177d5

# Use server time for auth signatures (helps if clock skew)
USE_SERVER_TIME=true

# Verify creds on startup (safe; no trading)
VERIFY_L2=true

# Emit a synthetic signal at boot to smoke-test wiring (no trading unless ENABLE_TRADING=true)
TEST_SIGNAL_ON_START=false

# --- Bot settings ---
# Fixed USDC amount per copied trade (v1)
FIXED_USDC_PER_TRADE=2

# Safety: if price moved more than this since signal, skip (e.g. 0.01 = 1 cent)
MAX_PRICE_MOVE=0.01

# --- Position mirror sizing (Path A) ---
# Ratio for copying trader notional (e.g. 50/500000 = 0.0001)
# 50 / 520000 ~= 0.0000961538
COPY_RATIO=0.0000961538
# Cap per detected signal
MAX_MY_USDC_PER_SIGNAL=5
# Minimum USDC per copied trade (floor)
MIN_MY_USDC_PER_SIGNAL=0.5
# Minimum shares per order (CLOB constraint; default 5)
MIN_SHARES_PER_ORDER=5
# How many recent activity items to pull per poll
ACTIVITY_LIMIT=50

# Kill switch
ENABLE_TRADING=true

# Execution quality (spread guard)
MAX_SPREAD_ABS=0.01
MAX_SPREAD_BPS=0

# Circuit breaker
MAX_CONSECUTIVE_ORDER_FAILURES=2

# Copytrader risk manager (cuts bad positions)
COPY_RISK_POLL_MS=30000
COPY_STOP_LOSS_ABS=0.03
COPY_TRAIL_ABS=0
COPY_MAX_HOLD_MS=43200000

# Exit reconciliation (close when trader exits)
COPY_EXIT_RECONCILE_POLL_MS=60000

# Logging
LOG_LEVEL=info

# --- selective mode tuning (added by assistant) ---
# Aim: fewer trades, more selective, compatible with ~$90 bankroll
COPY_RATIO=0.001
MAX_MY_USDC_PER_SIGNAL=5
MIN_MY_USDC_PER_SIGNAL=1
ACCUM_TTL_MS=86400000
MIRROR_STATS_INTERVAL_MS=60000
