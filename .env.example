# DO NOT COMMIT REAL SECRETS.

# --- Your trading wallet ---
# Private key used to sign for Polymarket CLOB API key derivation (L1) and/or order signing.
PRIVATE_KEY=

# Polymarket CLOB host + chain
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137

# Signature type (0=EOA, 1=POLY_PROXY, 2=GNOSIS_SAFE)
SIGNATURE_TYPE=0

# Funder address (the address that actually holds the funds / pays gas where applicable)
FUNDER=

# --- Optional: Use existing API creds instead of deriving ---
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# --- Bot settings ---
# Fixed USDC amount per copied trade (v1)
# (still used as fallback by some parts, but position mirroring now sizes proportionally)
FIXED_USDC_PER_TRADE=10

# --- Position mirror sizing (Path A) ---
# Copy ratio: how much of the trader's detected notional delta to mirror.
# Example: trader has ~$500k and you have ~$50 => ratio = 50/500000 = 0.0001
# Option A: set directly
COPY_RATIO=0.0001
# Option B: compute from these (leave COPY_RATIO empty)
MY_PORTFOLIO_USDC=
TRADER_PORTFOLIO_USDC=

# Cap how much YOU will allocate per detected signal (safety)
MAX_MY_USDC_PER_SIGNAL=5

# Ignore tiny position changes (in shares)
MIN_POSITION_DELTA_SHARES=1

# Safety: if price moved more than this since signal, skip (e.g. 0.01 = 1 cent)
MAX_PRICE_MOVE=0.01

# Kill switch
ENABLE_TRADING=false

# Logging
LOG_LEVEL=info
