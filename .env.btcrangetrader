# BTC range trader (PAPER)
ENABLE_TRADING=false

# Prefer faster, more reliable feeds first
BTC_FEED=coinbase,kraken,coingecko

BTC_TRADER_POLL_MS=15000
BTC_TRADER_MAX_PAGES=50
BTC_TRADER_CLIENT_TIMEOUT_MS=12000
# Gamma-based discovery disabled for now; using CLOB getMarkets pagination
BTC_TRADER_TARGET_CANDIDATES=60

# Risk
BTC_TRADER_MAX_ACTIVE_POSITIONS=1
BTC_TRADER_USDC_PER_TRADE=1
# Bankroll control: cap daily notional (bankroll is ~91 USDC)
BTC_TRADER_MAX_DAILY_NOTIONAL_USDC=15

# Entry selection
BTC_TRADER_MAX_STRIKE_DIST_PCT=0.08
BTC_TRADER_MOM_WINDOW=20

# Expiry window (days)
BTC_TRADER_MIN_DAYS_TO_EXPIRY=2
BTC_TRADER_MAX_DAYS_TO_EXPIRY=90

# Model vs market edge threshold (absolute probability / price units)
BTC_TRADER_MIN_EDGE_ABS=0.03

# Exit rules (token price movement)
BTC_TRADER_TAKE_PROFIT_ABS=0.02
BTC_TRADER_STOP_LOSS_ABS=0.02
BTC_TRADER_MAX_HOLD_MS=21600000

# Microstructure
MAX_SPREAD_ABS=0.01

LOG_LEVEL=info
